{
  "expo": {
    "name": "Glance",
    "slug": "glance",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "glance",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D0820",
    "ios": {
      "bundleIdentifier": "com.glanceprompter.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.glanceprompter.app",
      "adaptiveIcon": {
        "backgroundColor": "#0D0820",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0820",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Glance uses the camera so you can record yourself while reading your script.",
          "microphonePermission": "Glance uses the microphone to record your voice with the video.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Glance saves your recorded videos to Photos when you ask it to.",
          "savePhotosPermission": "Glance saves your recorded videos to Photos when you ask it to.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-sharing",
      "expo-video",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
